# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pub-bus-track

# Any long random string — used to sign login sessions (JWTs)
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000

# Frontend origin, for CORS. Use your deployed frontend URL in production.
CLIENT_URL=http://localhost:5173

# Optional: creates one admin account when you run `npm run seed`
ADMIN_EMAIL=admin@pub.ac.bd
ADMIN_PASSWORD=change_this_password

# Optional demo driver account for GPS testing
DRIVER_EMAIL=driver@pub.ac.bd
DRIVER_PASSWORD=change_this_password
DRIVER_PHONE=

# Optional Google OAuth. If omitted, email/password login remains fully available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Email verification (Resend). Get an API key from Resend and use a verified sender domain in production.
RESEND_API_KEY=
EMAIL_FROM=PUB Bus Track <onboarding@resend.dev>

# SIM/GPS device provisioning. Seed can also generate a secure token automatically.
# Optional per-bus overrides: GPS_DEVICE_TOKEN_PUB_01=your-secret-token
GPS_DEVICE_TOKEN_PUB_01=
GPS_DEVICE_TOKEN_PUB_02=
GPS_DEVICE_TOKEN_PUB_03=
GPS_DEVICE_TOKEN_PUB_04=
GPS_DEVICE_TOKEN_PUB_05=
GPS_DEVICE_TOKEN_PUB_06=
GPS_DEVICE_TOKEN_PUB_07=
GPS_DEVICE_TOKEN_PUB_08=
GPS_DEVICE_TOKEN_PUB_09=
GPS_DEVICE_TOKEN_PUB_10=
